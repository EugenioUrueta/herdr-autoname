# Configuration snippet for ~/.config/herdr/config.toml

[ui]
# Disables the interactive popup dialog when creating a new tab (Ctrl+b c).
# This allows herdr-autoname to assign the tab name automatically on startup.
prompt_new_tab_name = false

# Displays agent badges and status indicators (e.g. agy, claude, pi)
# on pane borders when no static manual label is set.
show_agent_labels_on_pane_borders = true
